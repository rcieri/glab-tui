#!/bin/bash
LOG_FILE="${TEST_LOG_PATH:-/tmp/glab_tui_test_calls.log}"
FIXTURES_DIR="${TEST_FIXTURES_DIR}"

echo "gh $*" >> "$LOG_FILE"
# One file per call with the exact argument boundaries, checked against the
# generated CLI reference by the e2e harness, and beside it, under the same
# name plus `.stdin`, the request body piped with `--input -`, and `.stdout`,
# what the mock printed. A shared file would interleave concurrent calls.
# Each is written under a dot name and renamed once complete, the body
# first and the output on exit, so the harness can wait for the record.
if [[ -n "$TEST_LOG_PATH" ]]; then
    mkdir -p "$TEST_LOG_PATH.argv.d"
    argv_record=$(mktemp "$TEST_LOG_PATH.argv.d/.XXXXXXXX")
    record="${argv_record%/.*}/${argv_record##*/.}"
    if [[ " $* " == *" --input - "* ]]; then
        cat > "$argv_record.stdin"
        mv "$argv_record.stdin" "$record.stdin"
    fi
    printf '%s\x1f' gh "$@" > "$argv_record"
    mv "$argv_record" "$record"
    exec 3>&1 > "$argv_record.stdout"
    trap 'cat "$argv_record.stdout" >&3; mv "$argv_record.stdout" "$record.stdout"' EXIT
fi

# A call this mock has no case for. The test harness fails the test when
# <log>.unhandled is not empty (see `Sandbox::drop`).
unhandled() {
    echo "gh $*" >> "$LOG_FILE.unhandled"
    echo "mock: unhandled: $*" >&2
    exit 2
}

# Generic failure injection: fail any call whose arguments contain the value.
if [[ -n "$TEST_GH_FAIL_MATCH" && "$*" == *"$TEST_GH_FAIL_MATCH"* ]]; then
    echo "mock: HTTP 404: Not Found" >&2
    exit 1
fi

# Hang injection: never answer a call whose arguments contain the value.
if [[ -n "$TEST_GH_HANG_MATCH" && "$*" == *"$TEST_GH_HANG_MATCH"* ]]; then
    exec sleep 300
fi

# The branch list: the fixture, plus the branch a `git/refs` POST created.
branches_json() {
    if [[ -f "$LOG_FILE.created_branch" ]]; then
        sed '$d' "$FIXTURES_DIR/branches.json" | sed '$s/}$/},/'
        printf '  {"name": "%s", "merged": false, "protected": false, "default": false, "commit": {"id": "a1b2c3d4e5f67890123456789012345678901234", "sha": "a1b2c3d4e5f67890123456789012345678901234"}}\n]\n' "$(cat "$LOG_FILE.created_branch")"
    else
        cat "$FIXTURES_DIR/branches.json"
    fi
}

# Match arguments to determine response
if [[ "$*" == *"run view"* ]] && [[ "$*" == *"--log"* ]]; then
    echo "mock github job trace output"
    exit 0
fi

# `pr list --state merged` serves only merged PRs, so a test can tell a list
# refetched for that state from one that was not.
if [[ "$*" == "pr list"* && " $* " == *" --state merged "* ]]; then
    cat "$FIXTURES_DIR/gh_prs_merged.json"
    exit 0
elif [[ "$*" == "run list"* ]]; then
    echo '[{"databaseId": 12345}]'
    exit 0
elif [[ "$*" == "run view "*"--json jobs"* ]]; then
    cat <<'EOF'
[{"databaseId": 54321, "name": "rspec", "status": "completed", "conclusion": "success",
  "url": "https://github.com/test-owner/test-repo/actions/runs/12345/job/54321"}]
EOF
    exit 0
elif [[ "$*" == "issue list"* || "$*" == "label list"* ]]; then
    echo "[]"
    exit 0
elif [[ "$*" == "auth status"* ]]; then
    # Logged in to github.com only, so other hosts resolve to GitLab.
    if [[ " $* " == *" --hostname "* && " $* " != *" --hostname github.com "* ]]; then
        echo "You are not logged into any accounts on that host" >&2
        exit 1
    fi
    exit 0
elif [[ "$*" == "pr merge "* || "$*" == "run rerun "* || "$*" == "run cancel "* ]]; then
    # Mutations whose output glab-tui does not read.
    exit 0
fi

# Stacked PRs merge through the asynchronous merge endpoint: the request is
# accepted as pending, and polling its uuid reports the merge done.
if [[ "$*" == *"/merge-async"* ]]; then
    if [[ " $* " == *" -X PUT "* ]]; then
        cat "$FIXTURES_DIR/gh_merge_async_pending.json"
    else
        cat "$FIXTURES_DIR/gh_merge_async_merged.json"
    fi
    exit 0
fi

# Stacked PRs: #10 and #11 form stack #7 (positions 1 and 2), #12 is in no
# stack. The per-PR query is matched first: it also asks for `stackEntry`.
if [[ "$*" == "pr list"* ]]; then
    cat "$FIXTURES_DIR/gh_prs.json"
    exit 0
fi

if [[ "$*" == "api graphql"*"entries(first"* ]]; then
    case "$*" in
        *"pullRequest(number:10)"*) position=1 ;;
        *"pullRequest(number:11)"*) position=2 ;;
        *)
            echo '{"data":{"repository":{"pullRequest":{"stackEntry":null,"stack":null}}}}'
            exit 0
            ;;
    esac
    cat <<EOF
{"data":{"repository":{"pullRequest":{
  "stackEntry":{"position":$position},
  "stack":{"number":7,"size":2,"entries":{"nodes":[
    {"position":1,"pullRequest":{"number":10,"title":"Stack bottom","state":"OPEN","isDraft":false}},
    {"position":2,"pullRequest":{"number":11,"title":"Stack top","state":"OPEN","isDraft":false}}]}}}}}}
EOF
    exit 0
fi

# Latest status of each deployment in tests/fixtures/gh_deployments.json.
if [[ "$*" == "api graphql"*"latestStatus"* ]]; then
    cat "$FIXTURES_DIR/gh_deployment_states_graphql.json"
    exit 0
fi

if [[ "$*" == "api graphql"*"stackEntry"* ]]; then
    cat "$FIXTURES_DIR/gh_pr_stack_summaries_graphql.json"
    exit 0
fi

# Pull requests. MOCK_GH_PR_DIFF_ERROR makes `pr diff` fail the way GitHub
# does: `too_large` for a diff over 20,000 lines, `not_found` otherwise.
# MOCK_GH_BASE_OID / MOCK_GH_HEAD_OID answer the commit-id lookup.
if [[ "$1" == "pr" && "$2" == "diff" ]]; then
    case "$MOCK_GH_PR_DIFF_ERROR" in
        too_large)
            echo "could not find pull request diff: HTTP 406: Sorry, the diff exceeded the maximum number of lines (20000) (https://api.github.com/repos/test-owner/test-repo/pulls/$3)" >&2
            echo "PullRequest.diff too_large" >&2
            exit 1
            ;;
        not_found)
            echo "GraphQL: Could not resolve to a PullRequest with the number of $3. (repository.pullRequest)" >&2
            exit 1
            ;;
    esac
    cat "$FIXTURES_DIR/mr_diff.txt"
    exit 0
fi
if [[ "$1" == "pr" && "$2" == "view" && "$*" == *"baseRefOid,headRefOid"* ]]; then
    printf '{"baseRefOid":"%s","headRefOid":"%s"}\n' "$MOCK_GH_BASE_OID" "$MOCK_GH_HEAD_OID"
    exit 0
fi

# The PR's conversation: two comments, a review summary and a review approved
# without a body.
if [[ "$1" == "pr" && "$2" == "view" && "$*" == *"comments,reviews"* ]]; then
    cat "$FIXTURES_DIR/gh_pr_conversation.json"
    exit 0
fi

if [[ "$*" == *"api"* ]]; then
    if [[ "$*" == "api user "* ]]; then
        echo "test-user"
    elif [[ "$*" == "api /repos/test-owner/test-repo" ]]; then
        # Repository info: the branch list reads the default branch from it.
        echo '{"default_branch": "main"}'
    elif [[ "$*" == *"/actions/jobs/"*"/cancel"* ]]; then
        # GitHub has no per-job cancel endpoint (#781).
        echo 'gh: Not Found (HTTP 404)' >&2
        exit 1
    elif [[ "$*" == *"/git/refs/heads/"* && "$*" != *" -X "* ]]; then
        # Resolving the branch a new one is created from.
        echo '{"ref": "refs/heads/main", "object": {"sha": "a1b2c3d4e5f67890123456789012345678901234"}}'
    elif [[ "$*" == *"/git/refs"* && " $* " == *" -X POST "* ]]; then
        sed -n 's/.*"ref":"refs\/heads\/\([^"]*\)".*/\1/p' "$record.stdin" > "$LOG_FILE.created_branch"
        echo '{}'
    elif [[ "$*" == *"closingIssuesReferences"* ]]; then
        echo '{"data": {"repository": {"pullRequest": {"closingIssuesReferences": {"nodes": []}}}}}'
    elif [[ "$*" == *"orgs/"*"/repos"*" --jq .[].full_name"* ]]; then
        echo "acme/project-b"
    elif [[ "$*" == *"/assignees"* || "$*" == *"orgs/"*"/members"* ]]; then
        echo "[]"
    # Review threads and comments span two pages. Only `--paginate` gets the
    # second one, printed right after the first as its own JSON document.
    elif [[ "$*" == *"reviewThreads"* ]]; then
        cat "$FIXTURES_DIR/gh_review_threads.json"
        if [[ " $* " == *" --paginate "* ]]; then
            cat "$FIXTURES_DIR/gh_review_threads_page2.json"
        fi
    elif [[ "$*" == *"/pulls/"*"/reviews"* ]]; then
        echo '{"id": 1}'
    elif [[ "$*" == *"/pulls/"*"/comments"* ]]; then
        if [[ " $* " == *" -X POST "* ]]; then
            echo '{"id": 1}'
        else
            cat "$FIXTURES_DIR/gh_pr_comments.json"
            if [[ " $* " == *" --paginate "* ]]; then
                cat "$FIXTURES_DIR/gh_pr_comments_page2.json"
            fi
        fi
    elif [[ "$*" == *"/issues/comments/"* ]]; then
        echo '{"body": "Comment from **octocat** on item one", "user": {"login": "octocat"}}'
    elif [[ "$*" == *"/issues"* ]]; then
        cat "$FIXTURES_DIR/issues.json"
    elif [[ "$*" == *"/pulls"* ]] || [[ "$*" == *"/merge_requests"* ]]; then
        cat "$FIXTURES_DIR/mrs.json"
    elif [[ "$*" == *"/branches"* ]]; then
        branches_json
    elif [[ "$*" == *"/deployments/"*"/statuses"* ]]; then
        if [[ " $* " == *" -X POST "* ]]; then
            echo '{"id": 1}'
        elif [[ "$*" == *"/deployments/100/"* ]]; then
            # The newest deployment failed, so the older one is still live.
            echo '[{"state": "failure"}]'
        else
            echo '[{"state": "success"}]'
        fi
    elif [[ "$*" == *"/environments"* ]]; then
        cat "$FIXTURES_DIR/gh_environments.json"
    elif [[ "$*" == *"/deployments"* ]]; then
        cat "$FIXTURES_DIR/gh_deployments.json"
    elif [[ "$*" == *"/pipelines"* ]] || [[ "$*" == *"/actions/runs"* ]]; then
        cat "$FIXTURES_DIR/gh_workflow_runs.json"
    elif [[ "$*" == *"/runners"* ]] || [[ "$*" == *"/actions/runners"* ]]; then
        cat "$FIXTURES_DIR/gh_runners.json"
    elif [[ "$*" == *"notifications"* ]]; then
        cat "$FIXTURES_DIR/gh_notifications.json"
    elif [[ "$*" == *"/milestones"* ]]; then
        cat "$FIXTURES_DIR/milestones.json"
    elif [[ "$*" == *"/jobs"* ]]; then
        cat "$FIXTURES_DIR/gh_run_jobs.json"
    else
        unhandled "$@"
    fi
else
    unhandled "$@"
fi
